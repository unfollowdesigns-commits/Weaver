# Copy to .env and fill in locally. Never commit .env, never paste keys into chat.

# --- Which model scores: mock (offline, free), openai (testing), claude (production) ---
SCORING_PROVIDER=mock

# --- Claude API (production scoring) ---
ANTHROPIC_API_KEY=
# Leave empty to use the default (claude-opus-5-5).
CLAUDE_MODEL=
# low | medium | high | xhigh | max. Leave empty for high.
CLAUDE_EFFORT=

# --- OpenAI (testing only, until the Claude key is set up) ---
OPENAI_API_KEY=
# Required when SCORING_PROVIDER=openai, for example the model your key has access to.
OPENAI_MODEL=

# --- Loxo ---
# API key: Loxo > Settings > API Keys (account admins only). Read access first.
LOXO_API_KEY=
# The agency slug and domain Loxo assigned (Loxo support can confirm them).
LOXO_AGENCY_SLUG=
LOXO_DOMAIN=app.loxo.co
# Requests per second to Loxo. Loxo rate-limits; lower this if you see 429 errors.
LOXO_MAX_PER_SECOND=4
# The job used for the first test run.
LOXO_TEST_JOB_ID=

# Where scores go in Loxo: scorecard (recommended) or note.
LOXO_WRITE_TARGET=scorecard
# IDs from: node scripts/loxo-check.js
LOXO_SCORECARD_TYPE_ID=
LOXO_RECOMMENDATION_YES_ID=
LOXO_RECOMMENDATION_NO_ID=
# Only if LOXO_WRITE_TARGET=note
LOXO_NOTE_ACTIVITY_TYPE_ID=

# --- Automatic scoring (server: scripts/serve.js, hourly sweep: scripts/sweep.js) ---
# Which searches to score automatically. Empty (or "all"): every open search in Loxo, found by
# Weaver itself every hour, so new searches are covered with nothing to type. Only to limit it:
# comma-separated search numbers.
LOXO_AUTO_SCORE_JOB_IDS=
# Searches never to score, comma-separated (for example the test search 3011811).
LOXO_SKIP_JOB_IDS=3011811
# New candidates are scored on every open search. The people already on a search when Weaver first
# sees it are scored only on the searches listed here (comma-separated). Empty: none. "all": every
# search (27,000+ people on DP's account: months at the daily cap, so not the default).
LOXO_BACKLOG_JOB_IDS=
# Where the server keeps who was already on each search (default: next to the daily cap file).
# BASELINE_FILE=
# Standard scorecard, used for any search without its own approved one in config/scorecards/jobs/.
SCORECARD_FILE=config/scorecards/standard-executive.v2.json
# Criteria for a search with no approved scorecard: drafted from the job the first time it is
# seen (the firm's own criteria names kept) and used straight away. false = approved only.
AUTO_CRITERIA=true
# Where drafted criteria are kept. On Render: a folder on the service's persistent disk,
# e.g. /var/data/criteria, so they survive deploys. Locally: data/scorecards/auto.
CRITERIA_DIR=
# The hourly catch-up runs inside the server, every N minutes. 0 = off (separate cron instead).
SWEEP_EVERY_MINUTES=60
# Client pipeline reports (phase 2): the firm name printed on the cover.
REPORT_FIRM_NAME=
PORT=8787
# Long random text (32+ characters). Loxo sends it with every webhook call.
WEBHOOK_SECRET=

# --- Cost guards ---
# Most AI calls the server makes per day (scoring, retries, batches, drafting criteria); the rest
# waits for the next day. Kept in a file on the disk (next to CRITERIA_DIR, or DAILY_CAP_FILE) so a
# restart does not reset it. The monthly limit on the Claude account is the hard stop.
DAILY_SCORE_CAP=200
DAILY_CAP_FILE=
# Most candidates the hourly sweep sends per run.
SWEEP_MAX_PER_RUN=50
# Sweep uses the half-price Batch API with Claude. Set false to score directly.
USE_BATCH=true
# Local testing only: keep webhook bodies and dry-run payloads in data/. Never on the server.
SAVE_DEBUG_FILES=false

# --- Safety switches ---
# true: no AI scoring at all (webhook and hourly catch-up). The full stop.
SCORING_PAUSED=false
# No write call runs against the live account until Josh has approved a dry run.
DRY_RUN=true
LOXO_WRITE_ENABLED=false
