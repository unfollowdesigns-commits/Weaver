# Copy to .env and fill in locally. Never commit .env, never paste keys into chat.

# --- Which model scores: mock (offline, free), openai (testing), claude (production) ---
SCORING_PROVIDER=mock

# --- Claude API (production scoring) ---
ANTHROPIC_API_KEY=
# Leave empty to use the default (claude-opus-5-5).
CLAUDE_MODEL=
# low | medium | high | xhigh | max. Leave empty for high.
CLAUDE_EFFORT=

# --- OpenAI (testing only, until the Claude key is set up) ---
OPENAI_API_KEY=
# Required when SCORING_PROVIDER=openai, for example the model your key has access to.
OPENAI_MODEL=

# --- Loxo ---
# API key: Loxo > Settings > API Keys (account admins only). Read access first.
LOXO_API_KEY=
# The agency slug and domain Loxo assigned (Loxo support can confirm them).
LOXO_AGENCY_SLUG=
LOXO_DOMAIN=app.loxo.co
# The job used for the first test run.
LOXO_TEST_JOB_ID=

# Where scores go in Loxo: scorecard (recommended) or note.
LOXO_WRITE_TARGET=scorecard
# IDs from: node scripts/loxo-check.js
LOXO_SCORECARD_TYPE_ID=
LOXO_RECOMMENDATION_YES_ID=
LOXO_RECOMMENDATION_NO_ID=
# Only if LOXO_WRITE_TARGET=note
LOXO_NOTE_ACTIVITY_TYPE_ID=

# --- Automatic scoring (server: scripts/serve.js, hourly sweep: scripts/sweep.js) ---
# Comma-separated Loxo job IDs to score automatically.
LOXO_AUTO_SCORE_JOB_IDS=
SCORECARD_FILE=config/scorecards/standard-executive.v1.json
PORT=8787
# Long random text (32+ characters). Loxo sends it with every webhook call.
WEBHOOK_SECRET=

# --- Cost guards ---
# Most candidates the server scores per day (the sweep picks up the rest next day).
DAILY_SCORE_CAP=200
# Most candidates the hourly sweep sends per run.
SWEEP_MAX_PER_RUN=50
# Sweep uses the half-price Batch API with Claude. Set false to score directly.
USE_BATCH=true
# Local testing only: keep webhook bodies and dry-run payloads in data/. Never on the server.
SAVE_DEBUG_FILES=false

# --- Safety switches ---
# No write call runs against the live account until Josh has approved a dry run.
DRY_RUN=true
LOXO_WRITE_ENABLED=false
