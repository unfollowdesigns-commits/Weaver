# Copy to .env and fill in locally. Never commit .env, never paste keys into chat.

# --- Loxo ---
# API key from DP's Loxo account. Read access first.
LOXO_API_KEY=
# Loxo API URLs include the agency slug. Unverified until a real call is made.
LOXO_AGENCY_SLUG=
LOXO_API_BASE_URL=
# The job used for the first test run.
LOXO_TEST_JOB_ID=

# --- Claude API ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# --- n8n ---
N8N_BASE_URL=
N8N_API_KEY=
# Shared secret to check that a trigger really comes from Loxo or n8n.
WEBHOOK_SECRET=

# --- Safety switches ---
# No write call runs against the live account until Josh has approved a dry run.
DRY_RUN=true
LOXO_WRITE_ENABLED=false
