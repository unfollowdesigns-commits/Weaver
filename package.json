{
  "name": "loxo-candidate-scoring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scores candidates on a Loxo job against a scorecard and writes an assessment back for recruiter review.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node --test",
    "score:sample": "node scripts/score-job.js --provider mock",
    "score:openai": "node scripts/score-job.js --provider openai",
    "score:claude": "node scripts/score-job.js --provider claude",
    "score:jobs": "node scripts/score-jobs.js",
    "fake-loxo": "node scripts/fake-loxo.js",
    "loxo:check": "node scripts/loxo-check.js",
    "serve": "node scripts/serve.js",
    "sweep": "node scripts/sweep.js",
    "scorecard:draft": "node scripts/draft-scorecard.js",
    "report:client": "node scripts/client-report.js",
    "verify": "node scripts/verify-run.js",
    "rescore": "node scripts/rescore-job.js",
    "rebar": "node scripts/rebar-run.js",
    "write-test": "node scripts/loxo-write-check.js",
    "preflight": "node scripts/preflight.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0"
  }
}
