      "patterns": [
        "outbound",
        "sourced",
        "new",
        "lead",
        "prospect",
        "added"
      ]
    }
  ],
  "unknown": "outbound",
  "funnel": [
    "outbound",
    "responded",
    "first",
    "second",
    "submitted"
  ]
