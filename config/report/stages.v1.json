      "patterns": [
        "no longer",
        "withdr",
        "declin",
        "reject",
        "not interested",
        "closed",
        "disqual"
      ]
    },
    {
      "id": "submitted",
      "label": "Submitted to client",
      "short": "Submitted",
      "patterns": [
        "submit",
        "client",
        "present",
        "offer",
        "placed"
      ]
    },
    {
      "id": "second",
      "label": "Second layer screen & cleared",
      "short": "Cleared",
      "patterns": [
        "second",
        "2nd",
        "cleared",
        "final"
      ]
    },
    {
      "id": "first",
      "label": "First layer screen",
      "short": "First screen",
      "patterns": [
        "first",
        "1st",
        "screen",
        "interview",
        "qualif"
      ]
    },
    {
      "id": "responded",
      "label": "Responded & initial conversation",
      "short": "Initial conversation",
      "patterns": [
